{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "gateway",
      "framework": "fastapi"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "litellm-dashboard": {
      "root": "ui/litellm-dashboard",
      "framework": "nextjs"
    },
    "rust-gateway": {
      "root": "litellm-rust/crates/gateway",
      "runtime": "rust",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "LITELLM_BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "litellm-dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "litellm-dashboard"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
