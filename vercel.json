{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "gateway",
      "framework": "fastapi"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "litellm-dashboard": {
      "root": "ui/litellm-dashboard",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "litellm-dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "litellm-dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
